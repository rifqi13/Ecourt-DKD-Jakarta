#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = ecourt_db_2
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# SESSION (pakai database untuk keamanan)
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\DatabaseHandler'
session.savePath = 'ci_sessions'
session.expiration = 7200

#--------------------------------------------------------------------
# ENCRYPTION (WAJIB diisi 32 karakter base64)
#--------------------------------------------------------------------
encryption.key = hex2bin:97e0cd18cba0cbeee90769fd39ad4dc637ea726f83447bc66219324968c72224

#--------------------------------------------------------------------
# EMAIL (SMTP — sesuaikan nanti)
#--------------------------------------------------------------------
email.protocol = smtp
email.SMTPHost = smtp.gmail.com
email.SMTPUser = ecourt_dkd_jakarta@peradi.or.id
email.SMTPPass = your-app-password
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = ecourt_dkd_jakarta@peradi.or.id
email.fromName = 'E-Court DKD Jakarta'

#--------------------------------------------------------------------
# DOKU (isi nanti saat integrasi)
#--------------------------------------------------------------------
doku.client_id = 
doku.secret_key = 
doku.env = sandbox